{
  "name": "@xiaozou-wine/context-orb",
  "version": "0.1.1",
  "type": "module",
  "description": "A floating orb over the composer shows the session's context window and compacts it on double-click",
  "icon": "./icon.svg",
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "context",
    "compaction",
    "web"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xiaozou-second/dsh-context-orb.git"
  },
  "homepage": "https://github.com/xiaozou-second/dsh-context-orb#readme",
  "bugs": {
    "url": "https://github.com/xiaozou-second/dsh-context-orb/issues"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./icon": "./icon.svg",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "icon.svg",
    "locale/*.json",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "engines": {
    "node": ">=24.9.0",
    "dsh": ">=0.2.2-rc.1"
  }
}
